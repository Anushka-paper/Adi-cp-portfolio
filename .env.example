# Postgres connection string (Neon or Supabase)
DATABASE_URL=

# Platform handles to sync
CODEFORCES_HANDLE=
LEETCODE_HANDLE=
ATCODER_HANDLE=

# Shared secret checked against the Authorization header on /api/sync,
# so only Vercel Cron (or you, manually) can trigger a sync.
CRON_SECRET=

# Single-credential admin auth for /admin (curated content editing)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
